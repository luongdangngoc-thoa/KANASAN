{% if product.metafields.custom.introduce_ingredients != blank %}
  <div class="product-ingredients gradient {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
    <div class="page-width">
      <div class="product-ingredients-contanier">
        {% if product.metafields.custom.introduce_ingredients.value.story_title != blank %}
          <h1 class="product-introduction-title {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
            {{ product.metafields.custom.introduce_ingredients.value.story_title | metafield_tag }}
          </h1>
        {% endif %}

        {% if product.metafields.custom.introduce_ingredients.value.story_paragraph != blank %}
          <div class="product-ingredients-paragraph {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
            {{ product.metafields.custom.introduce_ingredients.value.story_paragraph | metafield_tag }}
          </div>
        {% endif %}

        {% if product.metafields.custom.introduce_ingredients.value.story_demo_image != blank %}
          <div class="product-ingredients-demo-image">
            {{ product.metafields.custom.introduce_ingredients.value.story_demo_image | img_tag: '', '', '690x460' }}
          </div>
        {% endif %}

        <div class="product-ingredients-group {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
          {% if product.metafields.custom.introduce_ingredients.value.resort_story_image_1 != blank %}
            <div class="product-ingredients-image">
              {{
                product.metafields.custom.introduce_ingredients.value.resort_story_image_1
                | img_tag: '', '', '690x460'
              }}
            </div>
          {% endif %}
          <div class="product-ingredients-desc">
            {% if product.metafields.custom.introduce_ingredients.value.resort_story_heading_1 != blank %}
              <h3>
                {{ product.metafields.custom.introduce_ingredients.value.resort_story_heading_1 | metafield_tag }}
              </h3>
            {% endif %}
            {% if product.metafields.custom.introduce_ingredients.value.resort_story_description_1 != blank %}
              {{ product.metafields.custom.introduce_ingredients.value.resort_story_description_1 | metafield_tag }}
            {% endif %}
          </div>
        </div>

        {% if product.metafields.custom.introduce_ingredients.value.ingredient_title != blank %}
          <h1 class="product-introduction-title {% if  product.metafields.custom.introduce_ingredients.value.story_title != blank %} title-nth-child2 {% endif %} {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
            {{ product.metafields.custom.introduce_ingredients.value.ingredient_title | metafield_tag }}
          </h1>
        {% endif %}

        <div class="product-ingredients-group {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">

              {{ product.metafields.custom.introduce_ingredients.value.image_1 | img_tag: '', '', '690x460' }}
            </div>
          {% endif %}
          <div class="product-ingredients-desc">
            {% if product.metafields.custom.introduce_ingredients.value.heading_1 != blank %}
              <h3>{{ product.metafields.custom.introduce_ingredients.value.heading_1 | metafield_tag }}</h3>
            {% endif %}
            {% if product.metafields.custom.introduce_ingredients.value.description_1 != blank %}
              {{ product.metafields.custom.introduce_ingredients.value.description_1 | metafield_tag }}
            {% endif %}
          </div>
        </div>
        <div class="product-ingredients-group {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
          {% if product.metafields.custom.introduce_ingredients.value.image_2 != blank %}

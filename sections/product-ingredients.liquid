              {{ product.metafields.custom.introduce_ingredients.value.image_3 | img_tag: '', '', '690x460' }}
            </div>
          {% endif %}
          <div class="product-ingredients-desc">
            {% if product.metafields.custom.introduce_ingredients.value.heading_3 != blank %}

{% if product.metafields.custom.problem_solution != blank %}
  <div class="product-problem-solution gradient {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
    <div class="page-width">
      <div class="product-problem-solution-contanier">
          <div class="product-problem {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
            <h1 class="product-problem-heading">
              {% if product.metafields.custom.problem_solution.value.problem_heading != blank  %}
              {{ product.metafields.custom.problem_solution.value.problem_heading | metafield_tag }}
              {% endif %}
            </h1>
            <div class="product-problem-image">
              {% if product.metafields.custom.problem_solution.value.problem_image != blank  %}
              {{ product.metafields.custom.problem_solution.value.problem_image | img_tag: '', '', '680x400' }}
              {% endif %}
            </div>
            <div class="product-problem-list">
              {% if product.metafields.custom.problem_solution.value.problem_list != blank  %}
              {{ product.metafields.custom.problem_solution.value.problem_list | metafield_tag }}
              {% endif %}
            </div>
          </div>
          <div class="product-solution {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
            <h1 class="product-solution-heading">
              {% if product.metafields.custom.problem_solution.value.solution_heading != blank  %}
              {{ product.metafields.custom.problem_solution.value.solution_heading | metafield_tag  }}
              {% endif %}
            </h1>
            <div class="product-solution-image">
              {% if product.metafields.custom.problem_solution.value.solution_image != blank  %}
              {{ product.metafields.custom.problem_solution.value.solution_image | img_tag: '', '', '680x400' }}
              {% endif %}
            </div>
          </div>
          <div class="custom-add-to-cart-btn {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
              {%- for block in section.blocks -%}
              {%- case block.type -%}
              {%- when 'buy_buttons' -%}
                      {%- render 'buy-buttons',
                      block: block,
                      product: product,
                      product_form_id: product_form_id,
                      section_id: section.id
                      -%}
                  {%- endcase -%}
              {%- endfor -%}
          </div>
      </div>
    </div>
  </div>
{% else %}

{% endif %}
<style>
    .product-problem-solution {
        margin-top: 10rem;
    }
    .product-problem-solution-contanier {
        display: flex;
        justify-content: center;
        align-items: center;
        flex-direction: column;
        max-width: 68rem;
        margin: 0 auto;
    }

    .product-problem,  .product-solution {
        width: 100%;
        display: flex;
        justify-content: center;
        align-items: center;
        flex-direction: column;
        margin: 0 auto;
    }

    .product-problem-heading span, .product-solution-heading span {
        color: #595757;
        font-size: 2.8rem;
        font-style: normal;
        font-weight: 600;
        font-family: Inter, Noto Sans JP;
    }


    .product-problem-image,  .product-solution-image {
        width: 100%;
    }

    .product-problem-image img,  .product-solution-image img {
        width: 100%;
    }


    .product-solution {
        margin-top: 4rem;
    }
    
    .product-solution-heading {
        text-align: center;
    }

    .product-problem-list ul {
        list-style-image: url('https://cdn.shopify.com/s/files/1/0731/5213/5446/files/stick3.svg?v=1710309113');
    }

    .product-problem-list ul li::marker {
       width: 20px;
       display: inline-block;
    }

    .product-problem-list ul li {
        color: #595757;
        font-family: Inter, Noto Sans JP;
        font-size: 2rem;
        font-style: normal;
        font-weight: 500;
    }

    .custom-add-to-cart-btn .add-to-cart__button {
       max-width: 30rem !important;
    }
    .custom-add-to-cart-btn .swym-button {
       display: none !important;
    }

@media screen and (max-width: 749px) {

    .product-problem-solution {
        margin-top: 8rem;
    }


    .product-problem-heading span, .product-solution-heading span {
        font-size: 2.2rem;
        font-style: normal;
        font-weight: 600;
    }

    .product-problem-list ul li {
        color: #595757;
        font-family: Inter, Noto Sans JP;
        font-size: 1.8rem;
        font-style: normal;
        font-weight: 500;
    }

  }

</style>

{% schema %}
{
  "name": "Product problem solution",
  "tag": "section",
  "class": "section",
  "blocks": [ 
        {
        "type": "buy_buttons",
        "name": "t:sections.main-product.blocks.buy_buttons.name",
        "limit": 1,
        "settings": [
          {
            "type": "checkbox",
            "id": "show_dynamic_checkout",
            "default": false,
            "label": "t:sections.main-product.blocks.buy_buttons.settings.show_dynamic_checkout.label",
            "info": "t:sections.main-product.blocks.buy_buttons.settings.show_dynamic_checkout.info"
          }, {
            "type": "checkbox",
            "id": "show_gift_card_recipient",
            "default": false,
            "label": "t:sections.main-product.blocks.buy_buttons.settings.show_gift_card_recipient.label",
            "info": "t:sections.main-product.blocks.buy_buttons.settings.show_gift_card_recipient.info"
          }
        ]
      }
   ],
  "settings": [
  ],
  "presets": [
    {
      "name": "Product problem solution"
    }
  ]
}
{% endschema %}

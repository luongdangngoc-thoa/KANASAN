

<div class="product-uses gradient {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
  <div class="page-width">
    <div class="product-uses-contanier">
        {% if product.metafields.custom.uses.value.title_1 != blank  %}
        <h1 class="product-introduction-title {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"> {{ product.metafields.custom.uses.value.title_1 | metafield_tag }}</h1>
        {% endif %}

       <div class="product-uses-paragraph {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
            {% if product.metafields.custom.uses.value.paragraph != blank  %}
             {{ product.metafields.custom.uses.value.paragraph | metafield_tag }}
            {% endif %}
       </div>

        <div class="product-uses-group {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
           <div class="product-uses-image">
            {% if product.metafields.custom.uses.value.image_1 != blank %}
            {{ product.metafields.custom.uses.value.image_1 | img_tag: '', '', '690x460' }}
            {% endif %}
           </div>
           <div class="product-uses-desc">
            {% if product.metafields.custom.uses.value.heading_1 != blank  %}
            <h3> {{ product.metafields.custom.uses.value.heading_1 | metafield_tag }}</h3>
            {% endif %}
            {% if product.metafields.custom.uses.value.description_1 != blank  %}
            {{ product.metafields.custom.uses.value.description_1 | metafield_tag }}
            {% endif %}
           </div>
        </div>

        {% if product.metafields.custom.uses.value.title_2 != blank  %}
        <h1 class="product-introduction-title title-nth-child2 {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"> {{ product.metafields.custom.uses.value.title_2 | metafield_tag }}</h1>
        {% endif %}

        <div class="product-uses-group {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
           <div class="product-uses-image">
            {% if product.metafields.custom.uses.value.image_2 != blank %}
            {{ product.metafields.custom.uses.value.image_2 | img_tag: '', '', '690x460' }}
            {% endif %}
           </div>
           <div class="product-uses-desc">
            {% if product.metafields.custom.uses.value.heading_2 != blank  %}
            <h3> {{ product.metafields.custom.uses.value.heading_2 | metafield_tag }}</h3>
            {% endif %}
            {% if product.metafields.custom.uses.value.description_2 != blank  %}
            {{ product.metafields.custom.uses.value.description_2 | metafield_tag }}
            {% endif %}
           </div>
        </div>
        <div class="product-uses-group {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
           <div class="product-uses-image">
            {% if product.metafields.custom.uses.value.image_3 != blank %}
            {{ product.metafields.custom.uses.value.image_3 | img_tag: '', '', '690x460' }}
            {% endif %}
           </div>
           <div class="product-uses-desc">
            {% if product.metafields.custom.uses.value.heading_3 != blank  %}
            <h3> {{ product.metafields.custom.uses.value.heading_3 | metafield_tag }}</h3>
            {% endif %}
            {% if product.metafields.custom.uses.value.description_3 != blank  %}
            {{ product.metafields.custom.uses.value.description_3 | metafield_tag }}
            {% endif %}
           </div>
        </div>
        <div class="product-uses-group {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
           <div class="product-uses-image">
            {% if product.metafields.custom.uses.value.image_4 != blank %}
            {{ product.metafields.custom.uses.value.image_4 | img_tag: '', '', '690x460' }}
            {% endif %}
           </div>
           <div class="product-uses-desc">
            {% if product.metafields.custom.uses.value.heading_4 != blank  %}
            <h3> {{ product.metafields.custom.uses.value.heading_4 | metafield_tag }}</h3>
            {% endif %}
            {% if product.metafields.custom.uses.value.description_4 != blank  %}
            {{ product.metafields.custom.uses.value.description_4 | metafield_tag }}
            {% endif %}
           </div>
        </div>
    </div>
  </div>
</div>

<style>
    .product-uses {
        margin-top: 10rem;
    }
    .product-uses-contanier {
        display: flex;
        justify-content: center;
        align-items: center;
        flex-direction: column;
        max-width: 94rem;
        margin: 0 auto;
        width: 100%;
    }

    .product-introduction-title {
        color: #595757;
        font-family: Inter, Noto Sans JP;
        font-size: 2.8rem;
        font-style: normal;
        font-weight: 600;
    }

    .title-nth-child2 {
        margin-top: 12rem;
    }


    .product-uses-group {
        display: flex;
        justify-content: space-between;
        align-items: center;
        width: 100%;
        margin-top: 5rem;
    }

    .product-uses-group .product-uses-image {
        width: 34%;
    }

    .product-uses-group .product-uses-desc {
        width: 67%;
        padding-left: 3rem;
    }

    .product-uses-group .product-uses-image img {
        width: 100% ;
    }

    .product-uses-desc h3 {
        color: #595757;
        font-family: Inter, Noto Sans JP;
        font-size: 2rem;
        font-style: normal;
        font-weight: 600;
        margin: 0 !important;
        margin-bottom: 2.4rem !important;
    }

    .product-uses-paragraph,   .product-uses-desc p {
        color: #595757;
        font-family: Inter, Noto Sans JP;
        font-size: 1.6rem;
        font-style: normal;
        font-weight: 300;
        line-height: 2;
        margin: 0 !important;
    }

    .product-uses-paragraph {
        text-align: center;
        margin-top: 3rem !important;;
        margin-bottom: 5rem !important;;
    }

@media screen and (max-width: 749px) { 
    .product-uses {
        margin-top: 8rem;
    }

    .product-introduction-title {
        font-size: 2.2rem;
        font-style: normal;
        font-weight: 600;
    }

    .title-nth-child2 {
        margin-top: 8rem;
    }


    .product-uses-group {
        display: flex;
        justify-content: center;
        align-items: center;
        flex-direction: column;
        width: 100%;
        margin-top: 3rem;
    }

    .product-uses-group .product-uses-image {
        width: 100%;
    }

    .product-uses-group .product-uses-desc {
        width: 100%;
        padding-left: 0rem;
    }

    .product-uses-desc h3 {
        font-size: 1.8rem;
        font-style: normal;
        font-weight: 600;
        margin: 0 !important;
        margin-top: 1rem !important;
        margin-bottom: 1rem !important;
        line-height: 1.8;
    }
    
    }

</style>


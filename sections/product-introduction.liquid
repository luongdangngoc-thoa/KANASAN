{% if product.metafields.custom.introduction != blank %}
  <div class="product-introduction gradient {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
    <div class="page-width">
      <div class="product-introduction-contanier {{ product.metafields.custom.brands }}">
        <h1 class="product-introduction-heading">{{ product.metafields.custom.name_en }}</h1>
        <h3 class="product-introduction-heading-small">製品紹介</h3>
        <div class="product-introduction-text paragraph_1 {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
          {% if product.metafields.custom.introduction.value.paragraph_1 != blank %}
            {{ product.metafields.custom.introduction.value.paragraph_1 | metafield_tag }}
          {% endif %}
        </div>



        {%- if product.metafields.custom.introduction.value.image_list_1 != blank -%}
          <div
            class="product-introduction-image {% if product.metafields.custom.brands == 'KANASAN Resort' %}  image-vertical {% endif %}"
          >
            {% for image in product.metafields.custom.introduction.value.image_list_1.value %}
              <div class="introduction-image">
                <img
                  class="lazyload"
                  src=" {{ image | image_url: width: '1200px' }}"
                  data-aspectratio="{{ image.aspect_ratio }}"
                  data-sizes="auto"
                >
              </div>
            {% endfor %}
          </div>
        {%- endif -%}

        <div class="product-introduction-text paragraph_2 {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
          {% if product.metafields.custom.introduction.value.paragraph_2 != blank %}
            {{ product.metafields.custom.introduction.value.paragraph_2 | metafield_tag }}
          {% endif %}
        </div>

        {%- if product.metafields.custom.introduction.value.image_list_2 != blank -%}
          <div
            class="product-introduction-image"
          >
            {% for image in product.metafields.custom.introduction.value.image_list_2.value %}
              <div class="introduction-image">
                <img
                  class="lazyload"
                  src=" {{ image | image_url: width: '1200px' }}"
                  data-aspectratio="{{ image.aspect_ratio }}"
                  data-sizes="auto"
                >
              </div>
            {% endfor %}
          </div>
        {%- endif -%}

        <div class="product-introduction-text paragraph_3 {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
          {% if product.metafields.custom.introduction.value.paragraph_3 != blank %}
            {{ product.metafields.custom.introduction.value.paragraph_3 | metafield_tag }}
          {% endif %}
        </div>

        {%- if product.metafields.custom.introduction.value.image_list_3 != blank -%}
          <div
            class="product-introduction-image"
          >
            {% for image in product.metafields.custom.introduction.value.image_list_3.value %}
              <div class="introduction-image">
                <img
                  class="lazyload"
                  src=" {{ image | image_url: width: '1200px' }}"
                  data-aspectratio="{{ image.aspect_ratio }}"
                  data-sizes="auto"
                >
              </div>
            {% endfor %}
          </div>
        {%- endif -%}

        <div class="custom-add-to-cart-btn {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when 'buy_buttons' -%}
                {%- render 'buy-buttons',
                  block: block,
                  product: product,
                  product_form_id: product_form_id,
                  section_id: section.id
                -%}
            {%- endcase -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>
{% else %}

{% endif %}
<style>
  .product-introduction {
    margin-top: 10rem;
  }

  .product-introduction-contanier {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-direction: column;
    max-width: 68rem;
    margin: 0 auto;
  }

  .product-introduction-heading {
    text-align: center;
    color: #595757;
    font-family: Inter, Noto Sans JP;
    font-size: 2.8rem;
    font-style: normal;
    font-weight: 600;
    margin-bottom: 0 !important;
  }

  .product-introduction-heading-small {
    color: #595757;
    font-family: Inter, Noto Sans JP;
    font-size: 1.6rem;
    font-style: normal;
    font-weight: 500;
    margin-top: 1rem !important;
  }

  .Resort .product-introduction-text.paragraph_1 { 
    margin-top: 3rem;
    margin-bottom: 1rem;
  }

  .Resort .product-introduction-text.paragraph_2 { 
    margin-top: 2rem;
    margin-bottom: 2rem;
  }

  .Resort .product-introduction-text.paragraph_3 { 
    margin-top: 2rem;
  }

  .Nature .product-introduction-text.paragraph_1 { 
    margin-top: 5rem;
    margin-bottom: 5rem;
  }

  .Nature .product-introduction-text.paragraph_2 { 
    margin-top: 5rem;
    margin-bottom: 5rem;
  }

  .Style .product-introduction-text.paragraph_1 { 
    margin-top: 5rem;
    margin-bottom: 4rem;
  }

  .Style .product-introduction-text.paragraph_2 { 
    margin-top: 4rem;
    margin-bottom: 10rem;
  }

  .Style .product-introduction-text.paragraph_3 { 
    margin-top: 3.6rem;
  }

  .product-introduction-text p {
    text-align: center;
    margin: 0.8rem 0 !important;
    color: #595757;
    font-family: Inter, Noto Sans JP;
    font-size: 1.6rem;
    font-style: normal;
    font-weight: 300;
    line-height: 2;
  }

  .product-introduction-image {
    display: flex;
    justify-content: space-between;
    gap: 20px;
  }

  .product-introduction-image.image-vertical {
    flex-direction: column;
    row-gap: 40px;
  }
  .product-introduction-image img {
    width: 100%;
  }

  .product-introduction > div > div > div:nth-child(6) {
    margin-top: 6rem;
  }

  .custom-add-to-cart-btn .add-to-cart__button {
    max-width: 30rem !important;
  }
  .custom-add-to-cart-btn .swym-button {
    display: none !important;
  }

  @media screen and (max-width: 749px) {
    .product-introduction {
      margin-top: 8rem;
    }

    .product-introduction-heading {
      font-size: 2.2rem;
      font-style: normal;
      font-weight: 600;
    }

    .product-introduction-heading-small {
      font-size: 1.4rem;
      font-style: normal;
    }

    .product-introduction > div > div > div:nth-child(4) {
      margin-bottom: 4rem;
    }
  }
</style>

{% schema %}
{
  "name": "Product introduction",
  "tag": "section",
  "class": "section",
  "blocks": [
    {
      "type": "buy_buttons",
      "name": "t:sections.main-product.blocks.buy_buttons.name",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "show_dynamic_checkout",
          "default": false,
          "label": "t:sections.main-product.blocks.buy_buttons.settings.show_dynamic_checkout.label",
          "info": "t:sections.main-product.blocks.buy_buttons.settings.show_dynamic_checkout.info"
        },
        {
          "type": "checkbox",
          "id": "show_gift_card_recipient",
          "default": false,
          "label": "t:sections.main-product.blocks.buy_buttons.settings.show_gift_card_recipient.label",
          "info": "t:sections.main-product.blocks.buy_buttons.settings.show_gift_card_recipient.info"
        }
      ]
    }
  ],
  "settings": [],
  "presets": [
    {
      "name": "Product introduction"
    }
  ]
}
{% endschema %}
